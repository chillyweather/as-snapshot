#!/usr/bin/env bash
# Blessed repository launcher for Codex model qualification (Issue #734).
#
# Callable without spelling `python`. Resolves a usable project
# interpreter deterministically and execs the canonical command.
#
# Usage (from repository root or any subdirectory):
#   ./scripts/qualify-model --model <name> [--effort medium] [--backend codex-cli|claude-api] [--repetitions 3]
#                           [--workers 3] [--source-name <name> ...] [--rerun-baseline]
#   ./scripts/qualify-model --refresh-benchmark [--source-name <name> ...]
#
# Qualification replays the frozen benchmark through Codex (or the Claude
# API with --backend claude-api) and writes a report under
# data/model-qualification/reports. It never changes the pin in
# configs/codex-model-pin.json, never fetches source pages, and never
# calls Git. --refresh-benchmark is the only mode that reads Git history.

set -euo pipefail

# -- Resolve repository root ------------------------------------------------
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# -- Resolve project interpreter --------------------------------------------
# 1. The project-local virtualenv (fastest, no PATH lookup).
declare VENV_PYTHON="${REPO_ROOT}/.venv/bin/python"
if [[ -x "${VENV_PYTHON}" ]]; then
    INTERPRETER="${VENV_PYTHON}"
elif command -v python3 >/dev/null 2>&1; then
    # 2. Host python3 (fallback).
    INTERPRETER="$(command -v python3)"
else
    echo "auto-scout: no usable Python interpreter found" >&2
    echo "  checked: ${VENV_PYTHON} (not executable)" >&2
    echo "  python3 not on PATH" >&2
    exit 1
fi

# -- Change to repository root before exec ----------------------------------
cd "${REPO_ROOT}"

# -- Exec canonical command -------------------------------------------------
exec "${INTERPRETER}" -m autoscout qualify-model "$@"
