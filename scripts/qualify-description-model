#!/usr/bin/env bash
# Blessed repository launcher for description synthesis model qualification (Issue #843).
#
# Callable without spelling `python`. Resolves a usable project
# interpreter deterministically and execs the canonical command.
#
# Usage (from repository root or any subdirectory):
#   ./scripts/qualify-description-model --candidate [<backend>/]<model>:<effort> [--candidate ...]
#                                       [--repetitions 3] [--workers 3] [--items <slug> ...]
#   ./scripts/qualify-description-model --score <report-dir> [--ratings <file>]
#   ./scripts/qualify-description-model --refresh-benchmark
#
# Qualification replays the frozen synthesis benchmark through Codex (or the
# Claude API for a claude-api/ candidate) and
# writes a comparison report and a blind-review sheet under
# data/description-qualification/reports. It never changes a pin, never
# fetches source pages, and never calls Git. --refresh-benchmark is the only
# mode that reads Git history.

set -euo pipefail

# -- Resolve repository root ------------------------------------------------
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# -- Resolve project interpreter --------------------------------------------
# 1. The project-local virtualenv (fastest, no PATH lookup).
declare VENV_PYTHON="${REPO_ROOT}/.venv/bin/python"
if [[ -x "${VENV_PYTHON}" ]]; then
    INTERPRETER="${VENV_PYTHON}"
elif command -v python3 >/dev/null 2>&1; then
    # 2. Host python3 (fallback).
    INTERPRETER="$(command -v python3)"
else
    echo "auto-scout: no usable Python interpreter found" >&2
    echo "  checked: ${VENV_PYTHON} (not executable)" >&2
    echo "  python3 not on PATH" >&2
    exit 1
fi

# -- Change to repository root before exec ----------------------------------
cd "${REPO_ROOT}"

# -- Exec canonical command -------------------------------------------------
exec "${INTERPRETER}" -m autoscout qualify-description-model "$@"
