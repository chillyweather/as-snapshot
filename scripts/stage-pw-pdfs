#!/usr/bin/env bash
# Stage downloaded PW PDFs locally; never changes weekly state.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -x "${REPO_ROOT}/.venv/bin/python" ]]; then
    INTERPRETER="${REPO_ROOT}/.venv/bin/python"
else
    INTERPRETER="$(command -v python3)"
fi
cd "${REPO_ROOT}"
exec "${INTERPRETER}" -m autoscout.pw_local_backfill "$@"
