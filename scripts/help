#!/usr/bin/env bash
# List every command the operator can run, grouped by task.
#
# Offline and read-only. Usage (from repository root or any subdirectory):
#   ./scripts/help

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
INTERPRETER="${REPO_ROOT}/.venv/bin/python"
if [[ ! -x "${INTERPRETER}" ]]; then
    INTERPRETER="$(command -v python3)"
fi
cd "${REPO_ROOT}"
exec "${INTERPRETER}" -m autoscout.command_index "$@"
